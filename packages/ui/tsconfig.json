{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "jsx": "react-jsx",
  
      "declaration": true,
      "emitDeclarationOnly": true,
      "declarationMap": false,
      "outDir": "dist",
      "rootDir": "src",
  
      "skipLibCheck": true,
      "strict": false,
      "baseUrl": "."
    },
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules", "**/*.test.*"]
  }
  