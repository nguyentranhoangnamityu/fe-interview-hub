{
  // "files": [],
  "references": [
    // { "path": "./packages/ui" },
    // { "path": "./packages/hooks" },
    // { "path": "./packages/api" },
    // { "path": "./packages/utils" },
    // { "path": "./packages/types" },
    // { "path": "./packages/i18n" },
